---
let { 
    title, 
    desc, 
    variant="card-back",
} : {
    title?: string,
    desc?:string,
    variant?: "card-back" | "none",
} = Astro.props
---


<div class:list={["p-8 aspect-4/6 main-card", variant]}> 
    <h3 class="text-2xl font-bold mb-3">{title}</h3>
    <p class="text-lg">{desc}</p>
    <div class="grid place-content-center h-full">
        <slot></slot>
    </div>
</div>

<style>
    .card-back {
        transform: rotateY(180deg);
        position: absolute;
    }

    .main-card {
        height: 100%;
        width: 100%;
        backface-visibility: hidden;
        overflow: hidden;
        background: #fff;
        color: #000;
        border-radius: 12px;
    }

    .none {
        position: relative;
    }
</style>