<section class="w-screen py-40 h-screen">
    <div class="m-auto w-[80vw] grid grid-cols-2 gap-8">
        <h1 class="text-[4rem] font-bold">Контакти</h1>

        <div class="flex flex-col gap-2">
            <label class="font-medium" for="email">Email</label>
            <input name="email" class="p-4 bg-white rounded-lg" type="text" placeholder="Ваша пошта"/>
            <label class="font-medium mt-4" for="email">Імʼя</label>
            <input name="name" class="p-4 bg-white rounded-lg" type="text" placeholder="Ваше імʼя"/>
            <label class="font-medium mt-4" for="email">Повідомлення</label>
            <textarea name="message" class="p-4 bg-white rounded-lg" placeholder="Ваше повідомлення" rows="4" cols="50"/>
            <button class="bg-orange-600 text-white uppercase py-4 px-8 mt-8 rounded-lg self-start">Надіслати</button>
        </div>
    </div>
</section>