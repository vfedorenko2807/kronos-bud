---
import { Image } from "astro:assets";
import ServiceOne from "../../assets/service-1.png"
import ServiceTwo from "../../assets/service-2.png"
import ServiceThree from "../../assets/service-3.png"
import ServiceFour from "../../assets/service-4.png"

const services = [
    {title: "Житлові, комерційні та промислові об’єкти", desc: "Від нового будівництва до реконструкції, модернізації та капітального ремонту існуючих споруд."},
    {title: "Дорожнє будівництво", desc: "Будівництво автомобільних доріг, автострад, під'їзних шляхів та міської інфраструктури."},
    {title: "Інженерні споруди", desc: "Будівництво мостів, шляхопроводів, тунелів, естакад."},
    {title: "Архітектура та інжиніринг", desc: "Проєктування, геодезичні та геологічні роботи."},
]

---

<section class="services-scroll w-screen h-[700vh]">
    <div class="w-screen h-screen grid grid-cols-2 sticky top-0">
        <div class="relative bg-white">
            <p class="absolute top-80 left-32 uppercase text-gray-600 mb-2">Наші послуги</p>

            <div class="absolute top-1/2 -translate-y-1/2 left-32 w-[700px]">
                <h2 class="title-one text-[4rem] font-heading font-bold uppercase leading-[1] mb-4">{services[0].title}</h2>
                <p class="desc-one text-xl pr-32">{services[0].desc}</p>
            </div>

            <div class="absolute top-1/2 -translate-y-1/2 left-32 w-[700px]">
                <h2 class="title-two text-[4rem] font-heading font-bold uppercase leading-[1] mb-4">{services[1].title}</h2>
                <p class="desc-two text-xl pr-32">{services[1].desc}</p>
            </div>

            <div class="absolute top-1/2 -translate-y-1/2 left-32 w-[700px]">
                <h2 class="title-three text-[4rem] font-heading font-bold uppercase leading-[1] mb-4 pr-30">{services[2].title}</h2>
                <p class="desc-three text-xl pr-64">{services[2].desc}</p>
            </div>

            <div class="absolute top-1/2 -translate-y-1/2 left-32 w-[700px]">
                <h2 class="title-four text-[4rem] font-heading font-bold uppercase leading-[1] mb-4">{services[3].title}</h2>
                <p class="desc-four text-xl pr-32">{services[3].desc}</p>
            </div>
        </div>

        <div class="relative">
            <Image src={ServiceOne} alt="Service One" class="img-one w-full h-full object-cover absolute top-0 left-0 z-4 shadow-4xl" />
            <Image src={ServiceTwo} alt="Service Two" class="img-two w-full h-full object-cover object-top-left absolute top-0 left-0 z-3" />
            <Image src={ServiceThree} alt="Service Three" class="img-three w-full h-full object-cover absolute top-0 left-0 z-2" />
            <Image src={ServiceFour} alt="Service Four" class="img-four w-full h-full object-cover absolute top-0 left-0 z-1" />
        </div>
    </div>
</section>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { SplitText } from "gsap/SplitText";

    gsap.registerPlugin(ScrollTrigger, SplitText); 

    let titleOneSplit = SplitText.create('.title-one', { 
        type: "lines, words",
        mask: "lines",
    });
    let titleTwoSplit = SplitText.create('.title-two', { 
        type: "lines, words",
        mask: "lines",
    });
    let titleThreeSplit = SplitText.create('.title-three', { 
        type: "lines, words",
        mask: "lines",
    });
    let titleFourSplit = SplitText.create('.title-four', { 
        type: "lines, words",
        mask: "lines",
    });
    let descOneSplit = SplitText.create('.desc-one', { 
        type: "lines, words",
        mask: "lines",
    });
    let descTwoSplit = SplitText.create('.desc-two', { 
        type: "lines, words",
        mask: "lines",
    });
    let descThreeSplit = SplitText.create('.desc-three', { 
        type: "lines, words",
        mask: "lines",
    });
    let descFourSplit = SplitText.create('.desc-four', { 
        type: "lines, words",
        mask: "lines",
    });

    let tl = gsap.timeline({
        scrollTrigger: {
            trigger: '.services-scroll',
            start: 'top top',
            end: 'bottom bottom',
            scrub: true,
        }
    })

    // slide 1
    let slideOneTl = gsap.timeline();
    slideOneTl.to(titleOneSplit.lines, {
        y: -200,
        stagger: 0.025,
    })
    .to(descOneSplit.lines, {
        y: -200,
        stagger: 0.025,
    }, "<")
    .to(".img-one", {
        height: "0%"
    }, "<")

    // slide 2
    let slideTwoTl = gsap.timeline();
    slideTwoTl.from(titleTwoSplit.lines, {
        y: 200,
        stagger: 0.025,
    }, ">.5")
    .from(descTwoSplit.lines, {
        y: 200,
        stagger: 0.025,
    }, "<")
    .to(".pause", {}, "+=1")
    .to(titleTwoSplit.lines, {
        y: -200,
        stagger: 0.025,
    })
    .to(descTwoSplit.lines, {
        y: -200,
        stagger: 0.025,
    }, "<")
    .to(".img-two", {
        height: "0%"
    }, "<")

    // slide 3
    let slideThreeTl = gsap.timeline();
    slideThreeTl.from(titleThreeSplit.lines, {
        y: 200,
        stagger: 0.025,
    }, ">.5")
    .from(descThreeSplit.lines, {
        y: 200,
        stagger: 0.025,
    }, "<.2")
    .to(".pause", {}, "+=1")
    .to(titleThreeSplit.lines, {
        y: -200,
        stagger: 0.025,
    })
    .to(descThreeSplit.lines, {
        y: -200,
        stagger: 0.025,
    }, "<.2")
    .to(".img-three", {
        height: "0%"
    }, "<")

    // slide 4
    let slideFourTl = gsap.timeline();
    slideFourTl.from(titleFourSplit.lines, {
        y: 200,
        stagger: 0.025,
    }, ">.5")
    .from(descFourSplit.lines, {
        y: 200,
        stagger: 0.025,
    }, "<.2")

    //Master timeline
    tl.add(slideOneTl)
    .add(slideTwoTl, ">-1")
    .add(slideThreeTl, ">-1")
    .add(slideFourTl, ">-1")
    

</script>